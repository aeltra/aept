# libaept.abi - the ABI of libaept, guarded by test_abi_symbols.sh
#
# SPDX-FileCopyrightText: NONE
# SPDX-License-Identifier: MIT
#
# NONE rather than a copyright line because this file is extracted rather
# than written: "make abi-update" preprocesses the headers and sorts what
# it finds.  Whatever is protectable in these declarations is protectable
# in include/aept/, where it is already stated; restating it here would
# claim authorship of a transformation.  The licence is still named, so
# anything scanning the tarball has an answer for this file.
#
# One line per interface, "<kind>:<name>: <declaration>", sorted; "#"
# comments and blank lines ignored.  Regenerate with "make abi-update".
#
# Not just a symbol list.  A name tells you nothing about whether
# aept_install() grew an argument, whether a field was added to
# aept_pkg_info_t, or whether the AEPT_FLAG_* enumerators were reordered
# -- and each of those breaks callers that are not recompiled, silently,
# with the soname unchanged.  So the declarations are recorded whole.
#
# What the test does with a difference, per src/Makefile.am's rules:
#
#   a line disappears or changes   an interface was removed or altered.
#                                  FAILS.  major++, minor = revision = 0,
#                                  so old binaries are refused at load
#                                  time instead of dying on a missing or
#                                  mismatched symbol at run time.
#
#   a line appears                 an interface was added.  PASSES -- an
#                                  addition breaks no existing caller --
#                                  but needs minor++, revision = 0 before
#                                  release, and "make abi-update" here.
#
# Also enforced, independent of this file: what the shared object exports
# must be exactly what AEPT_API marks in include/aept/, so neither a
# leaked internal nor a declared-but-missing function can pass.
#
# The 31 in aept.h, plus the three the CLI needs because it links libaept
# like any other consumer: aept_log(), aept_malloc(), aept_asprintf().

enum:AEPT_ERR_NONE: enum { AEPT_ERR_NONE = 0, AEPT_ERR_GENERAL, AEPT_ERR_TIMEOUT, };
enum:AEPT_FLAG_FORCE_DEPENDS: enum { AEPT_FLAG_FORCE_DEPENDS, AEPT_FLAG_DOWNLOAD_ONLY, AEPT_FLAG_NOACTION, AEPT_FLAG_ALLOW_DOWNGRADE, AEPT_FLAG_REINSTALL, AEPT_FLAG_NO_CACHE, AEPT_FLAG_FORCE_CONFNEW, AEPT_FLAG_FORCE_CONFOLD, AEPT_FLAG_PURGE, AEPT_FLAG_NON_INTERACTIVE, AEPT_FLAG_CHECK_SIGNATURE, AEPT_FLAG_IGNORE_UID, AEPT_FLAG_KEEP_GOING, };
enum:AEPT_LOG_ERROR: enum { AEPT_LOG_ERROR = 0, AEPT_LOG_WARNING = 1, AEPT_LOG_INFO = 2, AEPT_LOG_DEBUG = 3, };
func:aept_architectures: AEPT_EXPORT int aept_architectures(aept_ctx_t *ctx, char ***archs_out, int *count_out);
func:aept_asprintf: AEPT_EXPORT int aept_asprintf(char **strp, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
func:aept_autoremove: AEPT_EXPORT int aept_autoremove(aept_ctx_t *ctx);
func:aept_cancel: AEPT_EXPORT void aept_cancel(aept_ctx_t *ctx);
func:aept_clean: AEPT_EXPORT int aept_clean(aept_ctx_t *ctx);
func:aept_cleanup: AEPT_EXPORT void aept_cleanup(aept_ctx_t *ctx);
func:aept_files: AEPT_EXPORT int aept_files(aept_ctx_t *ctx, const char *name, char ***paths_out, int *count_out);
func:aept_get_flag: AEPT_EXPORT int aept_get_flag(aept_ctx_t *ctx, int flag);
func:aept_init: AEPT_EXPORT aept_ctx_t *aept_init(void);
func:aept_install: AEPT_EXPORT int aept_install(aept_ctx_t *ctx, const char **names, int name_count, const char **local_paths, int local_count);
func:aept_last_error: AEPT_EXPORT int aept_last_error(aept_ctx_t *ctx);
func:aept_list: AEPT_EXPORT int aept_list(aept_ctx_t *ctx, const char *pattern, int filter_installed, int filter_upgradable, aept_pkg_list_t *out);
func:aept_load_config: AEPT_EXPORT int aept_load_config(aept_ctx_t *ctx, const char *path);
func:aept_log: AEPT_EXPORT void aept_log(int level, const char *file, int line, const char *fmt, ...) __attribute__((format(printf, 4, 5)));
func:aept_malloc: AEPT_EXPORT void *aept_malloc(size_t size);
func:aept_mark_auto: AEPT_EXPORT int aept_mark_auto(aept_ctx_t *ctx, const char **names, int count);
func:aept_mark_manual: AEPT_EXPORT int aept_mark_manual(aept_ctx_t *ctx, const char **names, int count);
func:aept_mark_manual_all: AEPT_EXPORT int aept_mark_manual_all(aept_ctx_t *ctx);
func:aept_owns: AEPT_EXPORT int aept_owns(aept_ctx_t *ctx, const char *path, char ***owners_out, int *count_out);
func:aept_pin: AEPT_EXPORT int aept_pin(aept_ctx_t *ctx, const char **specs, int count);
func:aept_pkg_info_free: AEPT_EXPORT void aept_pkg_info_free(aept_pkg_info_t *info);
func:aept_pkg_list_free: AEPT_EXPORT void aept_pkg_list_free(aept_pkg_list_t *list);
func:aept_remove: AEPT_EXPORT int aept_remove(aept_ctx_t *ctx, const char **names, int count);
func:aept_set_confirm_fn: AEPT_EXPORT void aept_set_confirm_fn(aept_ctx_t *ctx, aept_confirm_fn fn, void *userdata);
func:aept_set_display_fn: AEPT_EXPORT void aept_set_display_fn(aept_ctx_t *ctx, aept_display_fn fn, void *userdata);
func:aept_set_flag: AEPT_EXPORT void aept_set_flag(aept_ctx_t *ctx, int flag, int value);
func:aept_set_log_fn: AEPT_EXPORT void aept_set_log_fn(aept_ctx_t *ctx, aept_log_fn fn, void *userdata);
func:aept_set_network_timeout: AEPT_EXPORT void aept_set_network_timeout(aept_ctx_t *ctx, int seconds);
func:aept_set_offline_root: AEPT_EXPORT void aept_set_offline_root(aept_ctx_t *ctx, const char *path);
func:aept_set_verbosity: AEPT_EXPORT void aept_set_verbosity(aept_ctx_t *ctx, int level);
func:aept_show: AEPT_EXPORT int aept_show(aept_ctx_t *ctx, const char *name, aept_pkg_info_t *out);
func:aept_unpin: AEPT_EXPORT int aept_unpin(aept_ctx_t *ctx, const char **names, int count);
func:aept_update: AEPT_EXPORT int aept_update(aept_ctx_t *ctx);
func:aept_upgrade: AEPT_EXPORT int aept_upgrade(aept_ctx_t *ctx);
type:aept_confirm_fn: typedef int (*aept_confirm_fn)(void *userdata);
type:aept_ctx_t: typedef struct aept_ctx aept_ctx_t;
type:aept_display_fn: typedef void (*aept_display_fn)(const aept_transaction_t *txn, void *userdata);
type:aept_log_fn: typedef void (*aept_log_fn)(int level, const char *msg, void *userdata);
type:aept_pkg_entry_t: typedef struct { char *name; char *version; char *summary; int installed; int upgradable; } aept_pkg_entry_t;
type:aept_pkg_info_t: typedef struct { char *name; char *version; char *architecture; unsigned long long installed_size; char *depends; char *pre_depends; char *recommends; char *suggests; char *provides; char *conflicts; char *replaces; char *homepage; char *filename; char *summary; char *description; int is_installed; } aept_pkg_info_t;
type:aept_pkg_list_t: typedef struct { aept_pkg_entry_t *entries; int count; } aept_pkg_list_t;
type:aept_transaction_t: typedef struct aept_transaction { const char **install; int n_install; const char **upgrade; int n_upgrade; const char **reinstall; int n_reinstall; const char **remove; int n_remove; } aept_transaction_t;
