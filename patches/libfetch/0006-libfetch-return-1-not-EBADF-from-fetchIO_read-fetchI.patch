From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Koch <tobias.koch@gmail.com>
Date: Sat, 8 Aug 2026 16:21:43 +0300
Subject: [PATCH] libfetch: return -1, not EBADF, from
 fetchIO_read()/fetchIO_write()

Both functions return ssize_t, and returning EBADF returns a positive
9 -- which a caller reads as "9 bytes transferred" rather than as an
error.  A reader looping while the result is > 0 would treat 9 bytes of
uninitialised buffer as payload.

Set errno and return -1, matching the convention of the read/write
callbacks these functions wrap.
---
 libfetch/common.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/libfetch/common.c b/libfetch/common.c
index 26c56e3..1ab9123 100644
--- a/libfetch/common.c
+++ b/libfetch/common.c
@@ -1191,15 +1191,19 @@ fetchIO_unopen(void *io_cookie, ssize_t (*io_read)(void *, void *, size_t),
 ssize_t
 fetchIO_read(fetchIO *f, void *buf, size_t len)
 {
-	if (f->io_read == NULL)
-		return EBADF;
+	if (f->io_read == NULL) {
+		errno = EBADF;
+		return -1;
+	}
 	return (*f->io_read)(f->io_cookie, buf, len);
 }
 
 ssize_t
 fetchIO_write(fetchIO *f, const void *buf, size_t len)
 {
-	if (f->io_write == NULL)
-		return EBADF;
+	if (f->io_write == NULL) {
+		errno = EBADF;
+		return -1;
+	}
 	return (*f->io_write)(f->io_cookie, buf, len);
 }
