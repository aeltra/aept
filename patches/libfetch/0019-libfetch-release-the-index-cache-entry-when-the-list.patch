From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Koch <tobias.koch@aeltra.eu>
Date: Sat, 8 Aug 2026 19:41:05 +0300
Subject: [PATCH] libfetch: release the index cache entry when the listing
 fails

fetchListHTTP() allocates a http_index_cache entry up front when the 'c'
flag is set, then links it into index_cache only if the listing
completed successfully.  When it did not, the entry is neither linked
nor released, so the struct, the struct url returned by fetchCopyURL()
and every URL accumulated in cache->ue are leaked.

The pre-existing free on the fetchGetHTTP() failure path shows the
intent; this is the same cleanup for the case where the transfer starts
but the read or the index parse then fails.

Free it after the append, so the partial results are still handed to the
caller exactly as before.

Signed-off-by: Tobias Koch <tobias.koch@aeltra.eu>
---
 libfetch/http.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/libfetch/http.c b/libfetch/http.c
index 3d25786..060ced3 100644
--- a/libfetch/http.c
+++ b/libfetch/http.c
@@ -1538,13 +1538,21 @@ fetchListHTTP(struct url_list *ue, struct url *url, const char *pattern, const c
 	ret = read_len < 0 ? -1 : 0;
 
 	if (do_cache) {
-		if (ret == 0) {
+		int retained = (ret == 0);
+
+		if (retained) {
 			cache->next = index_cache;
 			index_cache = cache;
 		}
 
 		if (fetchAppendURLList(ue, &cache->ue))
 			ret = -1;
+
+		if (!retained) {
+			fetchFreeURLList(&cache->ue);
+			fetchFreeURL(cache->location);
+			free(cache);
+		}
 	}
 
 	return ret;
